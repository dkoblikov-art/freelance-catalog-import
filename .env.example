# Copy to .env and set a private password locally before starting Compose.
# Compose reads .env; Python does not load it automatically.
POSTGRES_USER=cat001_local
POSTGRES_PASSWORD=
POSTGRES_DB=cat001_learning

# Application: set privately in PyCharm Run Configuration -> Environment variables.
# PGUSER/PGPASSWORD must match POSTGRES_USER/POSTGRES_PASSWORD above.
PGHOST=127.0.0.1
PGPORT=55433
PGDATABASE=cat001_learning
PGUSER=cat001_local
PGPASSWORD=

# Integration tests: opt-in; create cat001_test separately on a new machine.
# Never fall back to PG* values.
CAT001_RUN_PG_TESTS=0
CAT001_TEST_HOST=127.0.0.1
CAT001_TEST_PORT=55433
CAT001_TEST_DBNAME=cat001_test
CAT001_TEST_USER=
CAT001_TEST_PASSWORD=
